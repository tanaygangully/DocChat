# Copy this file to .env.local and fill in each value.

# Neon Postgres connection string (from the Neon dashboard, or added
# automatically when you connect Neon to your Vercel project)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Google AI Studio → Get API key  (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# Optional overrides
# GEMINI_CHAT_MODEL="gemini-3.5-flash"
# GEMINI_EMBED_MODEL="gemini-embedding-2"

# Better Auth: any random 32+ character string (run: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Your site's URL: http://localhost:3000 locally, https://your-app.vercel.app in production
BETTER_AUTH_URL="http://localhost:3000"

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob (private store). Locally: run `vercel env pull .env.local` after
# connecting the store to your project. On Vercel it is set automatically.
BLOB_READ_WRITE_TOKEN=""
